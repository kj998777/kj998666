# Supabase 프로젝트 설정 → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key...

# 절대 브라우저로 노출되면 안 되는 키. 학생 제출/계정 관리 등 서버 전용 코드에서만 사용됨.
# Vercel 환경변수에 넣을 때도 "Server" 쪽에만 있으면 되고, NEXT_PUBLIC_ 접두사를 붙이면 안 됨.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# 로그인 성공 후 돌아올 사이트 주소 (배포 후에는 실제 도메인으로)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
